# Copie para .env e preencha. Este arquivo NÃO vai para o GitHub.

# Supabase → Project Settings → API (ou Data API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# chave "service_role" / "secret": dá acesso total, fica só aqui no servidor
SUPABASE_SERVICE_KEY=

# Chave para criptografar a sessão da conta secundária. Gere com:
#   docker compose run --rm mirante python -m mirante_worker secret
MIRANTE_SECRET=

# Proxy residencial fixo ("ISP proxy"), no Brasil. Formato: http://usuario:senha@ip:porta
IG_PROXY=

# Opcionais (os valores abaixo são o padrão)
# PACE_MIN=4
# PACE_MAX=8
# QUIET_START=2
# QUIET_END=6
# CHECK_EVERY_MIN=120
# PRIORITY_EVERY_MIN=60
# STORIES_EVERY_MIN=150
# STORY_VIDEO_HOURS=48
# STORY_KEEP_HOURS=168
